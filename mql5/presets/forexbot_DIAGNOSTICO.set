; forexbot v2 - DIAGNOSTICO de la estrategia (para BACKTEST/optimizacion)
; Mide el edge REAL de la estrategia SIN los topes de prop firm que mutilan
; las operaciones. NO usar en cuenta de desafio: aqui el objetivo diario y el
; corte de flotante estan DESACTIVADOS a proposito.
; Aplica a cualquier simbolo (Donchian). Cambia InpStrategy=1 para MACD.
InpStrategy=0
InpTimeframe=15
InpMagic=234099
InpNewBarOnly=true
InpDeviation=50
InpComment=fxbot-diag
InpRiskPerTrade=0.005
InpMaxLots=10.0
InpMaxPositions=1
InpAtrPeriod=14
InpAtrStop=1.5
InpAtrTarget=4.0
InpCloseEndOfDay=true
InpCloseHour=23
InpCloseMinute=30
InpUseSession=false
InpSessionStart=7
InpSessionEnd=20
InpDonchianPeriod=20
InpDonchianTrendFilter=true
InpDonchianTrendPeriod=100
InpMacdFast=12
InpMacdSlow=26
InpMacdSignal=9
InpMacdTrendPeriod=100
InpUseBreakEven=true
InpBreakEvenATR=1.0
InpBreakEvenLockATR=0.1
InpUseTrailing=true
InpTrailStartATR=1.5
InpTrailDistATR=2.0
InpUseProtection=true
InpMaxFloatDDPct=0.0
InpMaxDailyDDPct=0.0
InpMaxTotalDDPct=10.0
InpDailyBase=0
InpSafetyMarginPct=10.0
InpDailyProfitTarget=0.0
InpCloseOnTarget=false
InpHaltDayOnFloat=false
InpAlertOnBreach=false
InpResetGuard=false
InpShowPanel=true
